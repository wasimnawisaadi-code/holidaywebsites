# Trip portal environment. Copy to .env.local for development, and set the same
# names in the portal's own Vercel project — NOT the marketing site's.

# --- Supabase ---------------------------------------------------------------
# The same project as the marketing site. Every trip_* table is namespaced, so
# nothing here touches the website's leads or events.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The service role key. This is the ONLY key this application uses, it is read
# exclusively on the server, and it bypasses Row Level Security — which is the
# whole security model: the migration revokes anon's access to every trip table,
# so a customer's browser has no path to the database at all.
#
# There is deliberately no VITE_ prefixed Supabase key anywhere in this project.
# A VITE_ variable is compiled into the browser bundle; adding one here would
# hand every visitor a key to the customer data this portal exists to protect.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Needed only for staff sign-in via Supabase Auth (the anon key is used to
# verify a session token, never to read data).
SUPABASE_ANON_KEY=your-anon-key

# --- Admin access -----------------------------------------------------------
# Comma-separated. Holding a valid Supabase session is NOT sufficient — this
# project has public signup enabled, so an address must also be on this list.
TRIP_ADMIN_EMAILS=nawisaadiholidays@gmail.com,wasimnawisaadi@gmail.com

# Shared-password fallback, for local development or before Auth users exist.
# Also the signing key for those sessions, so changing it signs everyone out.
ADMIN_PASSWORD=choose-a-long-random-password

# --- Public origin ----------------------------------------------------------
# The origin baked into customer links and QR codes. Set this explicitly in
# production: a QR printed from a Vercel preview hostname stops resolving after
# the next deployment, and by then it is on a customer's welcome letter.
PORTAL_BASE_URL=https://trip.nawisaadi.com
