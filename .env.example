# Copy to .env.local for local development, and set the same names in Vercel.
# Never commit real values.

# --- Public: safe to expose, embedded in the browser bundle -----------------
# Row Level Security is what protects the data; the anon key may only INSERT
# events and cannot read a single row back.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server only: never exposed to the browser -----------------------------
# The service role key bypasses Row Level Security entirely. It is read only
# inside the SSR handler for /admin. If this ever leaks, rotate it immediately
# in Supabase -> Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=choose-a-long-random-password

# Comma-separated addresses allowed into /admin. This project has public
# signup enabled, so holding a valid Supabase session is NOT enough on its own
# — an address must also be on this list. Leave unset to use the built-in
# default (the agency address).
ADMIN_EMAILS=

# --- SEO / analytics (optional) --------------------------------------------
SITE_URL=https://www.nawisaadiholidays.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
PLAUSIBLE_DOMAIN=

# Must match SITE_URL. Read by the browser as well as the server, so that
# canonical and breadcrumb URLs agree on both sides and React does not report
# a hydration mismatch.
VITE_SITE_URL=https://www.nawisaadiholidays.com
